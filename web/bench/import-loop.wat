(component
  (import "api" (instance $api (export "item" (type (sub resource)))))
  (alias export $api "item" (type $item))
  (import "text" (func $text (param "s" string) (result u32)))
  (import "get-text" (func $get-text (param "selector" u32) (result string)))
  (import "pixels" (func $pixels (param "n" u32) (result (list u8))))
  (import "send-pixels" (func $send-pixels (param "data" (list u8)) (result u32)))
  (import "number" (func $number (param "v" u32) (result u32)))
  (import "acquire" (func $acquire (param "i" u32) (result (own $item))))
  (import "maybe" (func $maybe (param "i" u32) (result (option (own $item)))))
  (import "value" (func $value (param "r" (borrow $item)) (result u32)))
  (core module $storage
    (memory (export "mem") 2)
    ;; Each transfer consumes its result before the next allocation.
    (func (export "realloc") (param $old i32) (param $old-size i32) (param $align i32)
          (param $size i32) (result i32)
      (if (i32.or (local.get $old) (local.get $old-size)) (then unreachable))
      (if (i32.ne (local.get $align) (i32.const 1)) (then unreachable))
      (if (i32.and (i32.ne (local.get $size) (i32.const 123904))
                   (i32.and (i32.ne (local.get $size) (i32.const 16384))
                            (i32.ne (local.get $size) (i32.const 16)))) (then unreachable))
      (i32.const 1024))
    (data (i32.const 0) "tdxx-sample-id-with-ascii-bytes!"))
  (core instance $storage (instantiate $storage))
  (alias core export $storage "mem" (core memory $mem))
  (core func $text (canon lower (func $text) (memory $mem)))
  (alias core export $storage "realloc" (core func $realloc))
  (core func $get-text (canon lower (func $get-text) (memory $mem) (realloc $realloc)))
  (core func $pixels (canon lower (func $pixels) (memory $mem) (realloc $realloc)))
  (core func $send-pixels (canon lower (func $send-pixels) (memory $mem)))
  (core func $num (canon lower (func $number)))
  (core func $make (canon lower (func $acquire)))
  (core func $maybe (canon lower (func $maybe) (memory $mem)))
  (core func $read (canon lower (func $value)))
  (core func $drop (canon resource.drop $item))
  (core module $loop
    (import "" "read-string" (func $text (param i32 i32) (result i32)))
    (import "" "get-text" (func $get-text (param i32 i32)))
    (import "" "pixels" (func $pixels (param i32 i32)))
    (import "" "send-pixels" (func $send-pixels (param i32 i32) (result i32)))
    (import "" "number" (func $num (param i32) (result i32)))
    (import "" "acquire" (func $make (param i32) (result i32)))
    (import "" "maybe" (func $maybe (param i32 i32)))
    (import "" "value" (func $read (param i32) (result i32)))
    (import "" "drop" (func $drop (param i32)))
    (import "" "mem" (memory 1))
    (func (export "strings") (param $n i32) (param $len i32) (result i32)
      (local $sum i32)
      (loop $again
        (i32.store8 (i32.const 0) (i32.add (i32.const 65) (i32.and (local.get $n) (i32.const 15))))
        (local.set $sum (i32.add (local.get $sum) (call $text (i32.const 0) (local.get $len))))
        (br_if $again (local.tee $n (i32.sub (local.get $n) (i32.const 1)))))
      (local.get $sum))
    (func (export "numbers") (param $n i32) (result i32)
      (local $sum i32)
      (loop $again
        (local.set $sum (i32.add (local.get $sum) (call $num (local.get $n))))
        (br_if $again (local.tee $n (i32.sub (local.get $n) (i32.const 1)))))
      (local.get $sum))
    ;; Check the returned byte count before consuming the canonical string result.
    (func $read-text (param $selector i32) (result i32)
      (call $get-text (local.get $selector) (i32.const 80))
      (if (i32.ne (i32.load (i32.const 84))
                  (select (i32.const 16) (i32.const 16384) (i32.ge_u (local.get $selector) (i32.const 8))))
          (then unreachable))
      (i32.load (i32.const 80)))
    (func (export "text-returns") (param $n i32) (param $base i32) (result i32)
      (local $sum i32)
      (loop $again
        (local.set $sum (i32.add (local.get $sum)
          (i32.load8_u (call $read-text (i32.add (local.get $base) (i32.and (local.get $n) (i32.const 3)))))))
        (br_if $again (local.tee $n (i32.sub (local.get $n) (i32.const 1)))))
      (local.get $sum))
    ;; FNV-1a verifies each complete payload outside the timed loop.
    (func (export "text-digest") (param $selector i32) (result i32)
      (local $p i32) (local $end i32) (local $hash i32)
      (local.set $p (call $read-text (local.get $selector)))
      (local.set $end (i32.add (local.get $p) (i32.load (i32.const 84))))
      (local.set $hash (i32.const 2166136261))
      (loop $bytes
        (local.set $hash (i32.mul (i32.xor (local.get $hash) (i32.load8_u (local.get $p))) (i32.const 16777619)))
        (br_if $bytes (i32.lt_u (local.tee $p (i32.add (local.get $p) (i32.const 1))) (local.get $end))))
      (local.get $hash))
    (func (export "pixels") (param $n i32) (result i32)
      (local $p i32) (local $sum i32)
      (loop $again
        (call $pixels (local.get $n) (i32.const 80))
        (if (i32.ne (i32.load (i32.const 84)) (i32.const 123904)) (then unreachable))
        (local.set $p (i32.load (i32.const 80)))
        (local.set $sum (i32.add (local.get $sum) (i32.load8_u (local.get $p))))
        (br_if $again (local.tee $n (i32.sub (local.get $n) (i32.const 1)))))
      (local.get $sum))
    (func (export "pixel-writes") (param $n i32) (result i32)
      (local $sum i32)
      (loop $again
        (i32.store8 (i32.const 1024) (local.get $n))
        (local.set $sum (i32.add (local.get $sum) (call $send-pixels (i32.const 1024) (i32.const 123904))))
        (br_if $again (local.tee $n (i32.sub (local.get $n) (i32.const 1)))))
      ;; The host may retain the last list. It must still begin with 1.
      (i32.store8 (i32.const 1024) (i32.const 0))
      (local.get $sum))
    ;; After each timed pass verify the full transfer, including the last byte.
    (func (export "check-pixels") (result i32)
      (local $i i32) (local $p i32)
      (local.set $p (i32.load (i32.const 80)))
      (if (i32.ne (i32.load8_u (local.get $p)) (i32.const 1)) (then (return (i32.const 0))))
      (local.set $i (i32.const 1))
      (loop $bytes
        (if (i32.ne (i32.load8_u (i32.add (local.get $p) (local.get $i)))
                    (i32.and (local.get $i) (i32.const 255)))
          (then (return (i32.const 0))))
        (br_if $bytes (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 123904))))
      (i32.const 1))
    (func (export "options") (param $n i32) (result i32)
      (local $tag i32) (local $h i32) (local $sum i32)
      (loop $again
        (call $maybe (local.get $n) (i32.const 64))
        (local.set $tag (i32.load8_u (i32.const 64)))
        (if (i32.ne (local.get $tag) (i32.eqz (i32.and (local.get $n) (i32.const 1))))
          (then unreachable))
        (if (local.get $tag) (then
          (local.set $h (i32.load (i32.const 68)))
          (local.set $sum (i32.add (local.get $sum) (call $read (local.get $h))))
          (call $drop (local.get $h))))
        (br_if $again (local.tee $n (i32.sub (local.get $n) (i32.const 1)))))
      (local.get $sum))
    (func (export "resources") (param $n i32) (result i32)
      (local $h i32) (local $sum i32)
      (loop $again
        (local.set $h (call $make (local.get $n)))
        (local.set $sum (i32.add (local.get $sum) (call $read (local.get $h))))
        (call $drop (local.get $h))
        (br_if $again (local.tee $n (i32.sub (local.get $n) (i32.const 1)))))
      (local.get $sum)))
  (core instance $loop (instantiate $loop (with "" (instance
    (export "mem" (memory $mem)) (export "read-string" (func $text))
    (export "get-text" (func $get-text))
    (export "send-pixels" (func $send-pixels))
    (export "pixels" (func $pixels)) (export "number" (func $num)) (export "acquire" (func $make))
    (export "maybe" (func $maybe)) (export "value" (func $read)) (export "drop" (func $drop))))))
  (func (export "strings") (param "count" u32) (param "len" u32) (result u32) (canon lift (core func $loop "strings")))
  (func (export "pixels") (param "count" u32) (result u32) (canon lift (core func $loop "pixels")))
  (func (export "pixel-writes") (param "count" u32) (result u32) (canon lift (core func $loop "pixel-writes")))
  (func (export "text-returns") (param "count" u32) (param "base" u32) (result u32)
    (canon lift (core func $loop "text-returns")))
  (func (export "text-digest") (param "selector" u32) (result u32) (canon lift (core func $loop "text-digest")))
  (func (export "check-pixels") (result u32) (canon lift (core func $loop "check-pixels")))
  (func (export "options") (param "count" u32) (result u32) (canon lift (core func $loop "options")))
  (func (export "numbers") (param "count" u32) (result u32) (canon lift (core func $loop "numbers")))
  (func (export "resources") (param "count" u32) (result u32) (canon lift (core func $loop "resources"))))
