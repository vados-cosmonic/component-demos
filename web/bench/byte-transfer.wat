(component
  (import "read" (func $read (param "length" u32) (param "pattern" u32) (result (list u8))))
  (core module $storage
    (memory (export "memory") 2)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      i32.const 1024))
  (core instance $storage (instantiate $storage))
  (alias core export $storage "memory" (core memory $mem))
  (alias core export $storage "realloc" (core func $realloc))
  (core func $lower (canon lower (func $read) (memory $mem) (realloc $realloc)))
  (core module $loop
    (import "" "mem" (memory 2))
    (import "" "read" (func $read (param i32 i32 i32)))
    (func (export "run") (param $len i32) (param $n i32) (result i32)
      (local $sum i32) (local $p i32)
      (loop $again
        (call $read (local.get $len) (i32.and (local.get $n) (i32.const 1)) (i32.const 0))
        (if (i32.ne (i32.load (i32.const 4)) (local.get $len)) (then unreachable))
        (local.set $p (i32.load (i32.const 0)))
        (local.set $sum (i32.add (local.get $sum) (i32.add (i32.load8_u (local.get $p))
          (i32.load8_u (i32.sub (i32.add (local.get $p) (local.get $len)) (i32.const 1))))))
        (br_if $again (local.tee $n (i32.sub (local.get $n) (i32.const 1)))))
      (local.get $sum))
    (func (export "digest") (param $len i32) (result i32)
      (local $hash i32) (local $p i32) (local $end i32)
      (local.set $hash (i32.const 2166136261))
      (local.set $p (i32.load (i32.const 0)))
      (local.set $end (i32.add (local.get $p) (local.get $len)))
      (loop $again
        (local.set $hash (i32.mul (i32.xor (local.get $hash) (i32.load8_u (local.get $p))) (i32.const 16777619)))
        (br_if $again (i32.lt_u (local.tee $p (i32.add (local.get $p) (i32.const 1))) (local.get $end))))
      (local.get $hash)))
  (core instance $loop (instantiate $loop (with "" (instance (export "mem" (memory $mem)) (export "read" (func $lower))))))
  (func (export "run") (param "length" u32) (param "count" u32) (result u32) (canon lift (core func $loop "run")))
  (func (export "digest") (param "length" u32) (result u32) (canon lift (core func $loop "digest"))))
