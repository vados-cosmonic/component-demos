+    if (n.type === "VariableDeclaration" && n.kind !== "const") {
+      for (const d of n.declarations) {
+        if (d.init?.type === "CallExpression" && d.init.arguments[0]?.type === "ObjectExpression" &&
+            d.init.arguments[0].properties.some(p => p.key.value === "call stack exhausted")) declarations.push(d);
